# Transient coder sentinel — created by the coder agent on task completion,
# consumed and deleted by the agentStop hook that triggers oracle.
.coder-done

# Oracle run log — ephemeral, for debugging only.
.oracle-run.log
skills-lock.json

# Ephemeral task snapshot — generated by ralph-once.sh from the selected
# GitHub issue, consumed by the coder agent. Not tracked in git.
task.md